# -*- coding: utf-8, tab-width: 2 -*-

function fx_clear_vendor_logo {
  if [ "$hostname" == qemutest ]; then return 0; fi
  if [ "$safemode" == 1 ]; then return 0; fi

  # An attempt to clear vendor's EFI logo:
  set gfxpayload=text
  videoset 800x600
  clear
  videoset
  clear
}





















